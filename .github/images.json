      "target": "mc-faucet",
      "paths": ["mc-faucet/**"]
    },
    "mc-proposer": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "mc-proposer",
      "paths": ["mc-proposer/**"]
    },
    "mc-challenger": {
      "type": "go",
