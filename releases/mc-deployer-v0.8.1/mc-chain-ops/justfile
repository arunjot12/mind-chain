import '../justfiles/go.just'

# Build ldflags string
_VERSION_META_STR := if VERSION_META != "" { "+" + VERSION_META } else { "" }
_LDFLAGSSTRING := "'" + trim(
    "-X main.GitCommit=" + GITCOMMIT + " " + \
    "-X main.GitDate=" + GITDATE + " " + \
    "-X github.com/mindchain/mind-chain/mc-chain-ops/deployer/version.Version=" + VERSION + " " + \
    "-X github.com/mindchain/mind-chain/mc-chain-ops/deployer/version.Meta=" + _VERSION_META_STR + " " + \
    "") + "'"

# Build receipt-reference-builder binary
receipt-reference-builder: (go_build "./bin/receipt-reference-builder" "./cmd/receipt-reference-builder" "-ldflags" _LDFLAGSSTRING)

# Build interop-smoke binary
interop-smoke: (go_build "./bin/interop-smoke" "./cmd/interop-smoke" "-ldflags" _LDFLAGSSTRING)

# Run tests
test: (go_test "./...")

# Build mc-deployer binary
mc-deployer:
    just ../mc-deployer/build
    mkdir -p ./bin && ln -f ../mc-deployer/bin/mc-deployer ./bin/mc-deployer

# Run fuzzing tests
[private]
fuzz_task FUZZ TIME='10s': (go_fuzz FUZZ TIME "./crossdomain")

fuzz:
    printf "%s\n" \
        "FuzzEncodeDecodeWithdrawal" \
        "FuzzAliasing" \
        "FuzzVersionedNonce" \
    | parallel --tag -j {{PARALLEL_JOBS}} {{just_executable()}} fuzz_task {}
