{
  "shared_paths": [
    ".github/images.apko.json",
    ".github/workflows/build-images.apko.yaml",
    "melange/pipelines/**",
    "melange/op-stack-go.yaml",
    "melange/op-stack-rust.yaml",
    "melange/multicannon.yaml"
  ],
  "shared_go_paths": [
    "go.mod",
    "go.sum",
    "mc-service/**",
    "mc-core/**",
    "mc-chain-ops/**"
  ],
  "shared_rust_paths": [
    "rust/**"
  ],
  "melange_archs": [
    "x86_64",
    "aarch64"
  ],
  "apko_archs": "amd64,arm64",
  "release": {
    "tag_regex": "^([^/]+)/(v.+)$",
    "service_match": 1,
    "version_match": 2,
    "publish_tag": "${version}",
    "source_ref": "${ref_name}"
  },
  "smoke_runners": {
    "amd64": "ubuntu-24.04",
    "arm64": "ubuntu-24.04-arm"
  },
  "melange": {
    "op-stack-go": {
      "config": "melange/op-stack-go.yaml"
    },
    "op-stack-rust": {
      "config": "melange/op-stack-rust.yaml",
      "source": {
        "repository": "ethereum-optimism/optimism",
        "path": "."
      },
      "source_submodules": "recursive",
      "use_gha_cache": true,
      "cache_key_files": [
        "rust/Cargo.lock"
      ],
      "runner_profile": "large"
    },
    "kona-zkvm-canary": {
      "config": "melange/kona-zkvm-canary.yaml",
      "source": {
        "repository": "ethereum-optimism/optimism",
        "path": "."
      },
      "source_submodules": "recursive",
      "use_gha_cache": true,
      "cache_key_files": [
        "rust/Cargo.lock"
      ],
      "runner_profile": "large"
    },
    "multicannon": {
      "config": "melange/multicannon.yaml"
    },
    "mc-deployer": {
      "config": "melange/mc-deployer.yaml",
      "source": {
        "repository": "ethereum-optimism/optimism",
        "path": "."
      },
      "source_submodules": "recursive"
    }
  },
  "images": {
    "mc-node": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-node/**"
      ],
      "nexus_paths": [
        "apko/mc-node.yaml"
      ],
      "smoke_test": "mc-node --version"
    },
    "mc-batcher": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-batcher/**"
      ],
      "nexus_paths": [
        "apko/mc-batcher.yaml"
      ],
      "smoke_test": "mc-batcher --version"
    },
    "mc-proposer": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-proposer/**"
      ],
      "nexus_paths": [
        "apko/mc-proposer.yaml"
      ],
      "smoke_test": "mc-proposer --version"
    },
    "mc-conductor": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-conductor/**",
        "mc-node/**"
      ],
      "nexus_paths": [
        "apko/mc-conductor.yaml"
      ],
      "smoke_test": "mc-conductor --version"
    },
    "mc-dispute-mon": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-dispute-mon/**"
      ],
      "nexus_paths": [
        "apko/mc-dispute-mon.yaml"
      ],
      "smoke_test": "mc-dispute-mon --version"
    },
    "mc-dripper": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-dripper/**"
      ],
      "nexus_paths": [
        "apko/mc-dripper.yaml"
      ],
      "smoke_test": "mc-dripper --version"
    },
    "mc-faucet": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-faucet/**"
      ],
      "nexus_paths": [
        "apko/mc-faucet.yaml"
      ],
      "smoke_test": "mc-faucet --version"
    },
    "mc-interop-filter": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-interop-filter/**"
      ],
      "nexus_paths": [
        "apko/mc-interop-filter.yaml"
      ],
      "smoke_test": "mc-interop-filter --version"
    },
    "mc-interop-mon": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-interop-mon/**"
      ],
      "nexus_paths": [
        "apko/mc-interop-mon.yaml"
      ],
      "smoke_test": "mc-interop-mon --version"
    },
    "mc-supernode": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-supernode/**",
        "mc-node/**"
      ],
      "nexus_paths": [
        "apko/mc-supernode.yaml"
      ],
      "smoke_test": "mc-supernode --version"
    },
    "mc-test-sequencer": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-test-sequencer/**"
      ],
      "nexus_paths": [
        "apko/mc-test-sequencer.yaml"
      ],
      "smoke_test": "mc-test-sequencer --version"
    },
    "da-server": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go"
      ],
      "paths": [
        "mc-alt-da/**"
      ],
      "nexus_paths": [
        "apko/da-server.yaml"
      ],
      "smoke_test": "da-server --version"
    },
    "mc-challenger": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "op-stack-go",
        "multicannon",
        "op-stack-rust"
      ],
      "paths": [
        "mc-challenger/**",
        "cannon/**",
        "mc-preimage/**",
        "rust/kona/**"
      ],
      "nexus_paths": [
        "apko/mc-challenger.yaml"
      ],
      "smoke_test": "mc-challenger --version,cannon --help,cannon load-elf --type multithreaded64-5 --help,kona-host --help"
    },
    "kona-node": {
      "type": "rust",
      "verify_version": true,
      "needs_melange": [
        "op-stack-rust"
      ],
      "paths": [
        "rust/**"
      ],
      "nexus_paths": [
        "apko/kona-node.yaml"
      ],
      "smoke_test": "kona-node --version"
    },
    "kona-host": {
      "type": "rust",
      "needs_melange": [
        "op-stack-rust"
      ],
      "paths": [
        "rust/**"
      ],
      "nexus_paths": [
        "apko/kona-host.yaml"
      ],
      "smoke_test": "kona-host --help"
    },
    "kona-client": {
      "type": "rust",
      "needs_melange": [
        "op-stack-rust"
      ],
      "paths": [
        "rust/**"
      ],
      "nexus_paths": [
        "apko/kona-client.yaml"
      ],
      "smoke_test": "kona-client --help"
    },
    "op-zk-proposer": {
      "type": "rust",
      "needs_melange": [
        "op-stack-rust"
      ],
      "paths": [
        "rust/**"
      ],
      "nexus_paths": [
        "apko/op-zk-proposer.yaml"
      ],
      "smoke_test": "op-zk-proposer --version"
    },
    "kona-zkvm-canary": {
      "type": "rust",
      "needs_melange": [
        "kona-zkvm-canary"
      ],
      "paths": [
        "rust/**"
      ],
      "nexus_paths": [
        "apko/kona-zkvm-canary.yaml"
      ],
      "smoke_test": "kona-zkvm-canary --version"
    },
    "lokahi": {
      "type": "rust",
      "verify_version": true,
      "needs_melange": [
        "op-stack-rust"
      ],
      "paths": [
        "rust/**"
      ],
      "nexus_paths": [
        "apko/lokahi.yaml"
      ],
      "smoke_test": "lokahi --version"
    },
    "mc-reth": {
      "type": "rust",
      "verify_version": true,
      "needs_melange": [
        "op-stack-rust"
      ],
      "paths": [
        "rust/**"
      ],
      "nexus_paths": [
        "apko/mc-reth.yaml"
      ],
      "smoke_test": "mc-reth --version"
    },
    "mc-deployer": {
      "type": "go",
      "verify_version": true,
      "needs_melange": [
        "mc-deployer"
      ],
      "paths": [
        "mc-deployer/**",
        "packages/contracts-bedrock/**"
      ],
      "nexus_paths": [
        "melange/mc-deployer.yaml",
        "apko/mc-deployer.yaml",
        "melange/pipelines/mc-deployer/embed-artifacts.yaml",
        "melange/pipelines/mc-deployer/install-forge.yaml"
      ],
      "smoke_test": "mc-deployer --version,forge --version"
    }
  }
}
