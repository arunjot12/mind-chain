{
  "shared_paths": [
    "docker-bake.hcl",
    ".github/workflows/build-images.yaml",
    ".github/images.json",
    ".github/actions/docker-build-prep/**",
    "ops/scripts/compute-git-versions.sh"
  ],
  "shared_go_paths": [
    "go.mod",
    "go.sum",
    "ops/docker/op-stack-go/**",
    "mc-service/**",
    "mc-core/**",
    "mc-chain-ops/**"
  ],
  "images": {
    "mc-node": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "mc-node",
      "paths": ["mc-node/**"]
    },
    "mc-batcher": {
      "type": "go",
      "check": "go",
