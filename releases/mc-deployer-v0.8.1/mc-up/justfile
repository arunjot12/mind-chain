import '../justfiles/go.just'

_LDFLAGSSTRING := "'" + trim(
    "-X main.Version=" + VERSION + " " + \
    "-X main.VersionMeta=" + VERSION_META + " " + \
    "-X main.GitCommit=" + GITCOMMIT + " " + \
    "-X main.GitDate=" + GITDATE + " " + \
    "") + "'"

BINARY := "./bin/mc-up"

default: mc-up

mc-up: (go_build BINARY "." "-ldflags" _LDFLAGSSTRING)

artifacts:
    just ../mc-deployer/copy-contract-artifacts

clean:
    rm -f {{ BINARY }}
